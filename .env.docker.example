# Host ports (change if conflicts exist)
CLIENT_HOST_PORT=8080
SERVER_HOST_PORT=4000
MONGO_HOST_PORT=27018

# Server runtime configuration
NODE_ENV=production
DATABASE_URL=mongodb://mongo:27017/event-booking
JWT_SECRET=replace_with_a_strong_secret
APP_URLS=http://localhost:8080

# Client: passed at container runtime (entrypoint build) and as DEFAULT_VITE_* at image build
VITE_GRAPHQL_HTTP_URL=http://localhost:4000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:4000/graphql
VITE_APP_DOMAIN=http://localhost:8080
VITE_BASE_PATH=/

# Optional delivery settings
# Publish pushes: <DOCKER_IMAGE_REGISTRY>web-booking-e1-server:<tag> and web-booking-e1-client:<tag>
DOCKER_DELIVERY_MODE=build
DOCKER_IMAGE_TAG=local
DOCKER_IMAGE_REGISTRY=ghcr.io/your-org/
